-- ============================================================================
-- Environment Variables
-- ============================================================================
--
-- You can also use environment variables to override config values:
--
--   export MUD_HOST=localhost
--   export MUD_PORT=4242
--   export MUD_USER=mycharacter      # For auto-login
--   export MUD_PASSWORD=secretpass   # For auto-login (use carefully!)
--   export MUDC_CONFIG_DIR=/custom/path
--
-- Environment variables take precedence over config file values.

-- ============================================================================
-- Notes
-- ============================================================================
--
-- 1. This is a full Lua program - use any Lua features you need
-- 2. The file must return a table as the configuration
-- 3. Comments start with -- and are ignored
-- 4. Sections can be in any order
-- 5. File is watched - changes reload automatically
-- 6. Tilde (~) expansion works: "~/.config/mudc/scripts"
-- 7. You can require() other Lua files to modularize your config
