-- Mudc Configuration File
--
-- This is an example configuration file for Mudc MUD client.
-- Copy this to ~/.config/mudc/config.lua and customize as needed.
--
-- Configuration precedence (highest to lowest):
-- 1. Runtime options (passed to functions)
-- 2. Environment variables (MUD_HOST, MUD_PORT, etc.)
-- 3. This config file
-- 4. Default values (hardcoded)
--
-- The config file is watched for changes and reloaded automatically.

-- This is a Lua program! You can use variables, functions, and conditionals
-- to build your configuration dynamically.

-- Example: Read from environment or use default
local function env_or_default(var_name, default)
  return os.getenv(var_name) or default
end

-- Example: Conditional configuration based on hostname
local hostname = os.getenv("HOSTNAME") or "unknown"
local is_dev = string.find(hostname, "dev") ~= nil

-- ============================================================================
-- Connection Settings
-- ============================================================================

local connection = {
  -- Hostname or IP address of the MUD server (or MMapper proxy)
  -- Default: "localhost"
  -- Env var: MUD_HOST
  host = env_or_default("MUD_HOST", "localhost"),

  -- TCP port number
  -- Default: 4242 (MMapper default)
  -- Env var: MUD_PORT
  -- Common values:
  --   4242 - MMapper proxy (default)
  --   23   - Standard telnet
  --   4000 - Common MUD port
  port = tonumber(env_or_default("MUD_PORT", "4242")),

  -- Automatically connect on application startup
  -- Default: false
  -- Useful for development or when always connecting to same server
  auto_connect = is_dev,  -- Auto-connect in dev environment

  -- Delay (in milliseconds) before attempting reconnection after disconnect
  -- Default: 5000
  -- Only applies if connection was established with auto_connect enabled
  auto_reconnect_delay_ms = is_dev and 2000 or 5000,  -- Faster reconnect in dev

  -- TCP connection timeout in milliseconds
  -- Default: 5000
  -- How long to wait for connection before giving up
  -- Increase for slow/unreliable connections
  timeout_ms = 5000
}

-- ============================================================================
-- Protocol Settings
-- ============================================================================

local protocol = {
  -- Terminal type to report during telnet negotiation
  -- Default: "XTERM-256COLOR"
  terminal_type = "XTERM-256COLOR"
}

-- ============================================================================
-- Auto-login Settings
-- ============================================================================

local auto_login = {
  -- Prompt patterns for automatic login
  -- These are matched against server output
  name_prompt = "By what name do you wish to be known?",
  password_prompt = "Account password:"
}

-- ============================================================================
-- Scripting Settings
-- ============================================================================

local scripting = {
  -- Directory containing Lua script files (.lua)
  -- Default: "~/.config/mudc/scripts"
  -- Scripts are loaded in alphabetical order on startup
  -- Tip: Use number prefixes to control load order (01-core.lua, 02-triggers.lua)
  script_dirs = {"~/.config/mudc/scripts"},

  -- Automatically reload scripts when they change
  -- Default: true
  auto_reload = true
}

-- ============================================================================
-- UI Settings
-- ============================================================================

local ui = {
  -- Which screen to show on startup
  -- Default: "game"
  -- Options: "game", "debug", "info"
  default_screen = is_dev and "debug" or "game",

  -- Viewport height (number of lines to display)
  -- Default: 20
  viewport_height = 20,

  -- Maximum number of lines to keep in buffer
  -- Default: 1000
  max_lines = 1000,

  -- Maximum command history size
  -- Default: 100
  max_history_size = 100,

  -- Minimum viewport height (prevents shrinking too small)
  -- Default: 5
  min_viewport_height = 5,

  -- Vitals display thresholds
  vitals = {
    -- Show warning color when HP/mana/moves below this percentage
    warning_threshold = 0.7,  -- 70%

    -- Show danger color when HP/mana/moves below this percentage
    danger_threshold = 0.3    -- 30%
  }
}

-- ============================================================================
-- Logging Settings
-- ============================================================================

local logging = {
  -- Log level: "debug", "info", "warning", "error"
  -- Default: "info"
  level = is_dev and "debug" or "info",

  -- Directory for log files
  -- Default: "~/.config/mudc/logs"
  -- Tilde (~) expansion is supported
  directory = "~/.config/mudc/logs",

  -- Game log filename (stored in directory above)
  -- Default: "game.log"
  -- This file contains all game output and user input with timestamps
  game_log_file = "game.log",

  -- Maximum log file size in bytes before rotation
  -- Default: 10485760 (10 MB)
  -- When exceeded, the current log is renamed with a timestamp
  -- and a new log file is started
  max_log_size = 10 * 1024 * 1024  -- 10 MB
}

-- ============================================================================
-- Return the configuration table
-- ============================================================================

-- The config file must return a table with your configuration.
-- This is what gets loaded by Mudc.

return {
  connection = connection,
  protocol = protocol,
  auto_login = auto_login,
  scripting = scripting,
  ui = ui,
  logging = logging
}

